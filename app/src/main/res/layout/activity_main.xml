<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Luna VPN"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnMode1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SSH DIRECT"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnMode2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SSH + PROXY"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnMode3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SSH + SSL"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnMode4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SSH + SSL PROXY"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DESCONECTAR"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"/>
</LinearLayout>
